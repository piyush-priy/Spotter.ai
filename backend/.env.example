# ── Django / App ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-local-dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Provider API Keys ─────────────────────────────────────────────────────────
# Geocoding — OpenCage (https://opencagedata.com/) — free tier: 2500 req/day
OPENCAGE_API_KEY=your-opencage-api-key-here

# Routing — OpenRouteService (https://openrouteservice.org/) — free tier: 2000 req/day
ORS_API_KEY=your-openrouteservice-api-key-here

# Weather — Open-Meteo (https://open-meteo.com/) — completely free, no key required
# OPEN_METEO_API_KEY=not-required

# ── Optional / Observability ──────────────────────────────────────────────────
LOG_LEVEL=DEBUG

